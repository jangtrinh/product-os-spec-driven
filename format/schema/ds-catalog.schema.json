{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-driven.local/format/v2/ds-catalog.schema.json",
  "title": "Component or pattern catalog (AM-4)",
  "description": "Adapter-owned catalog of stable component/pattern handles. Copy catalogs keep their own {locale,entries} payload.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version","adapter","kind","items"],
  "properties": {
    "version": {"const":"1","x-spec-ref":false,"x-spec-ref-reason":"Closed version selector; no dependency identity.","x-spec-exclusion":{"category":"enum-literal"}},
    "adapter": {"type":"string","pattern":"^[a-z][a-z0-9-]*$","x-spec-ref":"ds-catalog-adapter"},
    "kind": {"enum":["component","pattern"],"x-spec-ref":false,"x-spec-ref-reason":"Closed kind selector; no dependency identity.","x-spec-exclusion":{"category":"enum-literal"}},
    "revision": {"type":"string","minLength":1,"x-spec-ref":false,"x-spec-ref-reason":"Content/version pin; binding context, not a separate reference.","x-spec-exclusion":{"category":"free-text"}},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["handle","name","status"],
        "properties": {
          "handle": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$","x-spec-ref":"ds-catalog-items-handle"},
          "name": {"type":"string","minLength":1,"maxLength":120,"x-spec-ref":false,"x-spec-ref-reason":"Literal name value; no reference namespace or dependency join.","x-spec-exclusion":{"category":"free-text"}},
          "api_ref": {"type":"string","minLength":1,"x-spec-ref":"ds-catalog-items-api-ref"},
          "usage_ref": {"type":"string","minLength":1,"x-spec-ref":"ds-catalog-items-usage-ref"},
          "status": {"enum":["active","deprecated","retired"],"x-spec-ref":false,"x-spec-ref-reason":"Closed status selector; no dependency identity.","x-spec-exclusion":{"category":"enum-literal"}},
          "replaced_by": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$","x-spec-ref":"ds-catalog-items-replaced-by"},
          "reason": {"type":"string","minLength":1,"x-spec-ref":false,"x-spec-ref-reason":"Literal reason value; no reference namespace or dependency join.","x-spec-exclusion":{"category":"free-text"}}
        },
        "allOf": [{"if":{"properties":{"status":{"enum":["deprecated","retired"],"x-spec-ref":false,"x-spec-ref-reason":"Constraint refinement; extraction belongs to the owning field.","x-spec-exclusion":{"category":"refinement-of","owner":"ds-catalog.schema.json#/properties/items/items/properties/status"}}},"required":["status"],"type":"object"},"then":{"required":["reason"],"type":"object","properties":{"reason":{"x-spec-ref":false,"x-spec-ref-reason":"Constraint refinement; extraction belongs to the owning field.","x-spec-exclusion":{"category":"refinement-of","owner":"ds-catalog.schema.json#/properties/items/items/properties/reason"}}}},"x-spec-ref":false,"x-spec-ref-reason":"Constraint refinement; extraction belongs to the owning field.","x-spec-exclusion":{"category":"refinement-of","owner":"ds-catalog.schema.json#/properties/items/items"}}]
      }
    }
  }
}
