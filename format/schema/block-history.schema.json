{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-driven.local/format/v2/block-history.schema.json",
  "title": "Exact block-level wording history",
  "type": "object",
  "required": ["version","entries"],
  "additionalProperties": false,
  "properties": {
    "version": {"type":"integer","enum":[1]},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id","page","date","kind","refs","source","previous_commit","before","after"],
        "properties": {
          "id": {"type":"string","minLength":1,"pattern":"^[a-z][a-z0-9-]*$","x-spec-ref":"block-history-entries-id"},
          "page": {"type":"string","minLength":1,"pattern":"^[a-z0-9][a-z0-9_-]*$","x-spec-ref":"block-history-entries-page"},
          "date": {"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","format":"date","x-spec-ref":false,"x-spec-ref-reason":"Timestamp/date value, not a dependency identity.","x-spec-exclusion":{"category":"format-value"}},
          "before": {"type":"string","x-spec-ref":false,"x-spec-ref-reason":"Literal before value; no reference namespace or dependency join.","x-spec-exclusion":{"category":"free-text"}},
          "after": {"type":"string","x-spec-ref":false,"x-spec-ref-reason":"Literal after value; no reference namespace or dependency join.","x-spec-exclusion":{"category":"free-text"}},
          "source": {"type":"string","x-spec-ref":"block-history-entries-source"},
          "previous_commit": {"type":"string","pattern":"^[a-f0-9]{40}$","x-spec-ref":false,"x-spec-ref-reason":"Content/version pin; binding context, not a separate reference.","x-spec-exclusion":{"category":"regex"}},
          "source_after": {"type":"string","x-spec-ref":"block-history-entries-source-after"},
          "next": {"type":"string","x-spec-ref":false,"x-spec-ref-reason":"Literal next value; no reference namespace or dependency join.","x-spec-exclusion":{"category":"free-text"}},
          "kind": {"type":"string","enum":["row","paragraph","list"],"x-spec-ref":false,"x-spec-ref-reason":"Closed kind selector; no dependency identity.","x-spec-exclusion":{"category":"enum-literal"}},
          "refs": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^(D\\d+|A-\\d+)$","x-spec-ref":"block-history-entries-refs"},"x-spec-ref":false,"x-spec-ref-reason":"Literal refs value; no reference namespace or dependency join.","x-spec-exclusion":{"category":"container-of","owner":"block-history.schema.json#/properties/entries/items/properties/refs/items"}},
          "occurrence": {"type":"integer","minimum":0}
        }
      }
    }
  }
}
