          "then": {"type":"object","properties":{"score":{"type":"null"},"reason":{"x-spec-ref":false,"x-spec-ref-reason":"Constraint refinement; extraction belongs to the owning field.","x-spec-exclusion":{"category":"refinement-of","owner":"model-common.schema.json#/$defs/criterion/properties/reason"}},"confirmer":{"x-spec-ref":false,"x-spec-ref-reason":"Constraint refinement; extraction belongs to the owning field.","x-spec-exclusion":{"category":"refinement-of","owner":"model-common.schema.json#/$defs/criterion/properties/confirmer"}}},"required":["reason","confirmer"]},
          "else": {
            "properties": {"score":{"type":"integer"}},
            "not": {"anyOf":[{"type":"object","properties":{"reason":{"x-spec-ref":false,"x-spec-ref-reason":"Constraint refinement; extraction belongs to the owning field.","x-spec-exclusion":{"category":"refinement-of","owner":"model-common.schema.json#/$defs/criterion/properties/reason"}}},"required":["reason"]},{"type":"object","properties":{"confirmer":{"x-spec-ref":false,"x-spec-ref-reason":"Constraint refinement; extraction belongs to the owning field.","x-spec-exclusion":{"category":"refinement-of","owner":"model-common.schema.json#/$defs/criterion/properties/confirmer"}}},"required":["confirmer"]}]},
            "x-spec-ref": false,
            "x-spec-ref-reason": "Constraint refinement; extraction belongs to the owning field."
          ,"x-spec-exclusion":{"category":"refinement-of","owner":"model-common.schema.json#/$defs/criterion"}},
          "x-spec-ref": false,
          "x-spec-ref-reason": "Constraint refinement; extraction belongs to the owning field."
        ,"x-spec-exclusion":{"category":"refinement-of","owner":"model-common.schema.json#/$defs/criterion"}}
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
