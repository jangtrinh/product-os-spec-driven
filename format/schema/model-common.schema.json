    "review": {"enum":["PASS","NEEDS_CHANGES","FAIL","BLOCKED","NOT_RUN"],"x-spec-ref":false,"x-spec-ref-reason":"Closed review selector; no dependency identity.","x-spec-exclusion":{"category":"enum-literal"}},
