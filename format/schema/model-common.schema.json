      "additionalProperties": false,
      "properties": {
        "kind": {"enum":["stage","artifact","bundle","us","ac"],"x-spec-ref":false,"x-spec-ref-reason":"Closed kind selector; no dependency identity.","x-spec-exclusion":{"category":"enum-literal"}},
        "ids": {"type":"array","items":{"type":"string","minLength":1,"x-spec-ref":"model-common-defs-scope-ids"},"minItems":1,"uniqueItems":true,"x-spec-ref":false,"x-spec-ref-reason":"Literal ids value; no reference namespace or dependency join.","x-spec-exclusion":{"category":"container-of","owner":"model-common.schema.json#/$defs/scope/properties/ids/items"}},
        "revision": {"type":"string","minLength":1,"x-spec-ref":false,"x-spec-ref-reason":"Content/version pin; binding context, not a separate reference.","x-spec-exclusion":{"category":"free-text"}}
      },
      "required": ["kind","ids","revision"]
    },
    "screen": {"type":"string","minLength":1,"pattern":"^S\\d{2}(-[a-z])?$","x-spec-ref":"model-common-defs-screen"},
