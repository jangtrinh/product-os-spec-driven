          "snapshot": {"anyOf":[{"$ref":"https://spec-driven.local/format/v2/model-common.schema.json#/$defs/path","x-spec-ref":false,"x-spec-ref-reason":"Constraint refinement; extraction belongs to the owning field.","x-spec-exclusion":{"category":"refinement-of","owner":"design-sources.schema.json#/properties/entries/items/properties/snapshot"}},{"type":"null","x-spec-ref":false,"x-spec-ref-reason":"Constraint refinement; extraction belongs to the owning field.","x-spec-exclusion":{"category":"refinement-of","owner":"design-sources.schema.json#/properties/entries/items/properties/snapshot"}}],"x-spec-ref":"design-sources-entries-snapshot"},
          "at": {"$ref":"https://spec-driven.local/format/v2/model-common.schema.json#/$defs/utc","x-spec-ref":false,"x-spec-ref-reason":"Timestamp/date value, not a dependency identity.","x-spec-exclusion":{"category":"alias-of","owner":"model-common.schema.json#/$defs/utc"}},
          "authority": {"type":"string","minLength":1,"x-spec-ref":"design-sources-entries-authority"},
          "freshness": {"$ref":"https://spec-driven.local/format/v2/model-common.schema.json#/$defs/freshness","x-spec-ref":false,"x-spec-ref-reason":"Shared value grammar; not a separate dependency at this alias.","x-spec-exclusion":{"category":"alias-of","owner":"model-common.schema.json#/$defs/freshness"}},
          "status": {"enum":["active","retired","unverified","missing"],"x-spec-ref":false,"x-spec-ref-reason":"Closed status selector; no dependency identity.","x-spec-exclusion":{"category":"enum-literal"}}
