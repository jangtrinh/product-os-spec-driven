            "then": {"properties":{"freshness":{"enum":["STALE","MISSING"],"x-spec-ref":false,"x-spec-ref-reason":"Constraint refinement; extraction belongs to the owning field.","x-spec-exclusion":{"category":"refinement-of","owner":"design-sources.schema.json#/properties/entries/items/properties/freshness"}}},"x-spec-ref":false,"x-spec-ref-reason":"Constraint refinement; extraction belongs to the owning field.","x-spec-exclusion":{"category":"refinement-of","owner":"design-sources.schema.json#/properties/entries/items"}},
