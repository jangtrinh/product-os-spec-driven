              "file_key": {"type":"string","minLength":1,"x-spec-ref":false,"x-spec-ref-reason":"Generated adapter external locator; navigation only, never a local dependency node.","x-spec-exclusion":{"category":"free-text"}},
              "node_id": {"type":"string","minLength":1,"x-spec-ref":false,"x-spec-ref-reason":"Generated adapter external locator; navigation only, never a local dependency node.","x-spec-exclusion":{"category":"free-text"}}
            },
            "required": [],
            "anyOf": [{"required":["url"],"type":"object","properties":{"url":{"x-spec-ref":false,"x-spec-ref-reason":"Constraint refinement; extraction belongs to the owning field.","x-spec-exclusion":{"category":"refinement-of","owner":"design-sources.schema.json#/properties/entries/items/properties/locator/properties/url"}}}},{"required":["file_key"],"type":"object","properties":{"file_key":{"x-spec-ref":false,"x-spec-ref-reason":"Constraint refinement; extraction belongs to the owning field.","x-spec-exclusion":{"category":"refinement-of","owner":"design-sources.schema.json#/properties/entries/items/properties/locator/properties/file_key"}}}}]
